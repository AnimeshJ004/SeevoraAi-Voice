# ---- 1. Target VPS (For Production Deploy Scripts) --------------------------
# Fresh Ubuntu 24.04, 4GB RAM recommended (2GB works with swap). Ports 22, 80, 443 open.
VPS_IP=
SSH_KEY=~/.ssh/id_rsa

# ---- 2. Speech to Text: Deepgram --------------------------------------------
# console.deepgram.com. nova-3 handles Hinglish and low-latency audio.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ---- 3. Brain (LLM): Groq ---------------------------------------------------
# console.groq.com. Fast enough that the pause before a reply is not noticeable.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
LLM_MODEL=qwen/qwen3.8-27b

# ---- 4. Voice Engine (TTS): Rumik silk --------------------------------------
# rumik.ai. mulberry is the fast model, muga is expressive. Sits behind Cloudflare.
TTS_PROVIDER=rumik
RUMIK_API_KEY=
RUMIK_MODEL=muga
TTS_MODEL=muga
RUMIK_VOICE=ira
# Voice direction for muga (expressive model). Without this, muga produces off/unnatural pronunciation.
# Tune this description to shape the exact voice character you want.
RUMIK_VOICE_DESCRIPTION=a warm, clear Indian-English female voice with a natural conversational tone, friendly and professional, equally natural in English, Hindi, and Hinglish

# ---- 5. Telephony: Vobiz ----------------------------------------------------
# console.vobiz.ai. Indian numbers, Plivo-compatible API.
# Leave VOBIZ_APPLICATION_ID BLANK. Dograh auto-creates and attaches its own application.
VOBIZ_AUTH_ID=
VOBIZ_AUTH_TOKEN=
VOBIZ_NUMBER=
VOBIZ_APPLICATION_ID=

# ---- 6. Orchestrator: Dograh ------------------------------------------------
# Dograh console admin login (created on first signup)
DOGRAH_EMAIL=
DOGRAH_PASSWORD=

# Dograh API and workflow bindings (generated in Dograh console or via 03-configure.sh)
DOGRAH_BASE_URL=https://app.dograh.com
DOGRAH_API_KEY=
DOGRAH_WORKFLOW_ID=
DOGRAH_NO_RECORDING_WORKFLOW_ID=
DOGRAH_TELEPHONY_CONFIG_ID=
DOGRAH_PHONE_NUMBER_ID=
DOGRAH_EMBED_TOKEN=

# ---- 7. Dashboard & Studio Server -------------------------------------------
PORT=8787
DASHBOARD_PORT=8787
RAPIDX_PUBLIC_URL=http://localhost:8787

# Local Test User bootstrap (password at least 12 characters)
TEST_USER_EMAIL=demo@rapidx.ai
TEST_USER_PASSWORD=RapidXDemo1234!
TEST_USER_TENANT=RapidX Demo
TEST_USER_SUPER_ADMIN=true

# ---- 8. Cal.com Appointment Booking -----------------------------------------
# cal.com/settings/developer/api-keys
CALCOM_API_KEY=

# ---- 9. WACRM & WhatsApp Automation -----------------------------------------
# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Token Encryption (AES-256-GCM 64-hex string, auto-generated)
ENCRYPTION_KEY=

# Meta App Secret (Meta for Developers -> App Settings -> Basic)
META_APP_SECRET=

# Public Site URL & Locale
NEXT_PUBLIC_SITE_URL=http://localhost:8787
NEXT_PUBLIC_APP_LOCALE=en

# WhatsApp Business Cloud Credentials (Meta for Developers -> WhatsApp -> API Setup)
WHATSAPP_PHONE_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=seevora_wa_verify_token

# External WACRM Instance (if connecting to hosted WACRM)
WACRM_BASE_URL=http://localhost:3000
WACRM_API_KEY=

# ---- 10. Clerk Authentication ------------------------------------------------
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_WEBHOOK_SECRET=whsec_your_clerk_webhook_secret

# ---- 11. Razorpay Payment Gateway --------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=https://seevoraai-voice-739104077203.asia-south1.run.app/api/billing/razorpay/webhook

