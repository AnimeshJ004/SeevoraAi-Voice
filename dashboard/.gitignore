# Secrets. Never commit real keys.
.env

# Runtime state (db.json tracked for deployment seed).
data/*.tmp
data/*.log

# Dependencies (there are none, but never sync these if they ever appear).
node_modules
node_modules.nosync

# Legacy reference, kept local only.
_legacy

# Old flat-file agent store, superseded by data/db.json.
agents.json

# Logs and OS cruft.
*.log
.DS_Store
public/samples/*.tmp
